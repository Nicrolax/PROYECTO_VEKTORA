# =====================================================================================
# VEKTORA · Variables de entorno
# =====================================================================================
# Infraestructura 100% gratuita: todos los servicios de abajo tienen free tier.
# Copiar a `.env.local` (Next.js lo carga automáticamente y está en .gitignore).
# Las claves de servicio NUNCA llevan el prefijo NEXT_PUBLIC_.
# =====================================================================================

# --- Supabase ----------------------------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Usadas SOLO en servidor. service_role bypassea RLS: es la identidad de los agentes
# autónomos (ProjectPlanner, matching, AI Judge) y de la telemetría de ai_runs.
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Propietario por defecto de los proyectos que crea `npm run plan`. Debe ser el uuid de
# una fila EXISTENTE de public.users (el mismo uuid que en auth.users). Si se omite, el
# script toma el usuario activo más antiguo. `npm run db:check` verifica ambas cosas.
# VEKTORA_OWNER_ID=<uuid-de-public.users>

# Umbral de similitud coseno para mapear un slug de skill propuesto por un proveedor a una
# skill ya existente del catálogo (FASE 3.5). Por debajo del umbral se crea una skill nueva.
# Bajarlo agrupa más agresivamente; subirlo deja crecer el catálogo con más facilidad.
# 0.95 está MEDIDO con `npm run skills:calibrate`: el par de skills distintas más parecido
# del catálogo llega a 0.9220 y los sinónimos reales rondan 0.99.
# VEKTORA_SKILL_MATCH_THRESHOLD=0.95

# --- Motor de matching híbrido (FASE 4) --------------------------------------------
# Los tres pesos DEBEN sumar 1.0: si no, match_score se sale de [0,1] y la restricción
# CHECK de task_applications rechaza el insert.
# VEKTORA_MATCH_W_VECTOR=0.45
# VEKTORA_MATCH_W_SKILL=0.35
# VEKTORA_MATCH_W_REPUTATION=0.20
#
# Recalibración del coseno. gemini-embedding-001 comprime el rango, así que el coseno
# crudo no discrimina: este tramo se estira a [0,1]. Los valores por defecto están MEDIDOS
# sobre la distribución tarea-vs-perfil real (mín 0.7318 · mediana 0.7805 · máx 0.8607).
# Se definen por los EXTREMOS de la muestra, no por percentiles, así que con pocos
# proveedores se mueven: vuelve a correr `npm run skills:calibrate` cuando crezca el
# mercado y ajusta aquí, sin tocar código.
# VEKTORA_MATCH_VECTOR_FLOOR=0.73
# VEKTORA_MATCH_VECTOR_CEILING=0.89
#
# Saturación de reputación: rep/(rep+K). Con K=50, 50 puntos valen 0.5.
# VEKTORA_MATCH_REPUTATION_K=50
# Valor neutro para quien no tiene historial. 0.5 y no 0: penalizar la ausencia de
# historial produce arranque en frío permanente.
# VEKTORA_MATCH_NEUTRAL_PRIOR=0.5
#
# VEKTORA_MATCH_MIN_SKILL_COVERAGE=0.01
# VEKTORA_MATCH_MIN_SCORE=0.25
# VEKTORA_MATCH_CANDIDATE_LIMIT=20
# VEKTORA_MATCH_SHORTLIST=5
# match_score a partir del cual se adjudica sin intervención humana.
# Umbral de adjudicación automática. 0.50 DERIVADO del techo de un proveedor NUEVO: sin
# historial su reputación vale 0.25, así que con todas las skills y afinidad mediana llega a
# 0.54. Con 0.70 no llegaba nadie, y la tarea quedaba con una candidatura pendiente que NADIE
# puede aceptar — en este sistema no hay nadie. Un umbral inalcanzable rompe la regla 1.
# VEKTORA_MATCH_AUTO_ASSIGN_MIN=0.50

# --- Groq · proveedor primario de generación (free tier) ---------------------------
# https://console.groq.com/keys
GROQ_API_KEY=<gsk_...>
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Los modelos se retiran: `npm run ai:models` lista los que admiten TUS claves.
# GROQ_MODEL=openai/gpt-oss-120b

# --- Google AI Studio · fallback de generación + embeddings (free tier) ------------
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=<AIza...>
# GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GOOGLE_AI_MODEL=gemini-3.6-flash
# Presupuesto de "thinking" de Gemini 2.5. 0 lo desactiva: más rápido y barato para
# extracción estructurada. Si se omite, manda el default del modelo.
# GOOGLE_AI_THINKING_BUDGET=0

# --- Embeddings (Google AI Studio) -------------------------------------------------
# gemini-embedding-001 es nativo de 3072 dimensiones y admite recorte MRL; Google
# recomienda 3072 / 1536 / 768. Se usa 1536 para encajar con vector(1536) de
# db/schema.sql (~99% de la calidad de 3072 con la mitad de almacenamiento).
#
# OJO: text-embedding-004 produce 768 dimensiones y outputDimensionality solo RECORTA,
# nunca amplía, así que NO puede dar 1536; además fue dado de baja el 2026-01-14. Si se
# usa, hay que fijar AI_EMBEDDING_DIMENSIONS=768 y migrar el schema a vector(768) con sus
# índices HNSW. La validación de entorno rechaza la combinación imposible en el arranque.
# AI_EMBEDDING_MODEL=gemini-embedding-001
# AI_EMBEDDING_DIMENSIONS=1536
# AI_EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
# AI_EMBED_CONCURRENCY=2

# --- Política de fallback y reintentos ---------------------------------------------
# AI_PROVIDER_ORDER=groq,google
# AI_REQUEST_TIMEOUT_MS=45000
# AI_MAX_ATTEMPTS_PER_PROVIDER=2
# AI_MAX_REPAIR_ATTEMPTS=2
# AI_RETRY_BASE_DELAY_MS=500
# AI_RETRY_MAX_DELAY_MS=8000
# AI_TEMPERATURE=0.2
# AI_MAX_OUTPUT_TOKENS=8192

# --- Telemetría en ai_runs ---------------------------------------------------------
# AI_LOG_PAYLOADS guarda prompts y respuestas (truncados) en request_payload /
# response_payload. Ponerlo en false si los objetivos de proyecto son sensibles.
# AI_LOG_PAYLOADS=true
# AI_LOG_PAYLOAD_MAX_CHARS=8000

# --- Agente autónomo de QA · AI Judge (FASE 5) -------------------------------------
# Puntuación (0-100) para aprobar. 100 por defecto: los criterios de aceptación son
# condiciones, no una nota media — aprobar con 80 acepta que 1 de cada 5 criterios que el
# cliente pidió no se cumple.
# VEKTORA_QA_APPROVE_SCORE=100
#
# Por debajo de esto se rechaza en vez de pedir cambios. Pedir revisión de algo que no
# tiene nada que ver con lo pedido solo quema turnos.
# VEKTORA_QA_REVISION_FLOOR=40
#
# Confianza mínima para fiarse de un "pass" del modelo. Por debajo, el criterio pasa a
# "sin evidencia suficiente" (pide más), NO a incumplido (cierra la tarea).
# VEKTORA_QA_MIN_CONFIDENCE=0.6
#
# Versiones del entregable tras las cuales una revisión se convierte en rechazo. Sin tope,
# proveedor y juez pueden quedarse en un bucle y la tarea no termina nunca — y en un DAG,
# todo lo que dependía de ella tampoco avanza.
# VEKTORA_QA_MAX_ATTEMPTS=3
#
# Intentos que deben existir antes de que el suelo pueda CERRAR una tarea. Una sola llamada
# a un modelo no puede decidir algo irreversible: la misma entrega, con el mismo modelo y
# temperatura 0, dio "no puedo comprobarlo" en una corrida y "no se cumple" en la siguiente.
# VEKTORA_QA_MIN_ATTEMPTS_BEFORE_REJECT=2
#
# Movimientos de reputación. Pedir cambios NO mueve reputación a propósito.
# VEKTORA_QA_APPROVED_DELTA=8
# VEKTORA_QA_TASK_COMPLETED_DELTA=4
# VEKTORA_QA_REJECTED_DELTA=6
# VEKTORA_QA_TASK_FAILED_DELTA=8
#
# VEKTORA_QA_QUEUE_LIMIT=20
# VEKTORA_QA_MAX_OUTPUT_TOKENS=4096

# --- Interfaz web (FASE 6) ----------------------------------------------------------
# Secreto compartido con los trabajos programados de Vercel. SIN ESTO los disparadores
# devuelven 503 y no corren: un despliegue que deja a los agentes expuestos es peor que uno
# donde el ciclo automático está apagado. Generalo con: openssl rand -hex 32
CRON_SECRET=<cadena-larga-aleatoria>

# --- Escalada del emparejamiento (FASE 7) --------------------------------------------
# Rondas sin adjudicar tras las cuales se acepta al mejor candidato por encima del mínimo.
# Sin esto, una tarea cuyo mejor candidato puntúa 0.49 contra un umbral de 0.50 se queda
# parada PARA SIEMPRE, y con ella todo lo que dependa de ella. Se cuenta en rondas y no en
# horas para que la escalada se pueda mostrar en una demostración.
# VEKTORA_MATCH_ESCALATE_AFTER_ROUNDS=4

# --- Cuotas de uso (FASE 7) -----------------------------------------------------------
# Cada proyecto planificado cuesta una llamada al modelo más una vectorización por tarea.
# Sin tope, unos pocos usuarios agotan el free tier para todos. Poner 0 deshabilita la
# acción por completo.
# VEKTORA_QUOTA_PROYECTOS=5
# VEKTORA_QUOTA_PROYECTOS_HORAS=24
# VEKTORA_QUOTA_PROVEEDOR=10
# VEKTORA_QUOTA_PROVEEDOR_HORAS=24
# VEKTORA_QUOTA_ENTREGAS=30
# VEKTORA_QUOTA_ENTREGAS_HORAS=24
